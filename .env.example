# DBC Care / Hospital AI Assistant
# Copy to `.env` and fill in keys. Never commit `.env`.
# Conda env: hosmanag

# --- CLI text agent ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Cascade voice: Deepgram STT + DeepSeek LLM + Deepgram TTS ---
DEEPGRAM_API_KEY=
# Optional Owner/Admin key with billing:read (Admin balance display). Falls back to DEEPGRAM_API_KEY.
# DEEPGRAM_MANAGE_API_KEY=
# DEEPGRAM_VOICE=aura-2-thalia-en

# DeepSeek (Cascade LLM default)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash     # cheapest; V4 thinking mode is disabled by default
# DEEPSEEK_THINKING=0                   # set 1 to re-enable V4 thinking (slower, costlier)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

GLM_API_KEY=
# GLM_MODEL=glm-4-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Realtime voice: OpenAI ---
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_CHAT_MODEL=gpt-5.6-luna       # cheapest GPT-5.6; temperature is not sent for GPT-5.x
# OPENAI_REASONING_EFFORT=none          # must stay "none" for tool calls on Chat Completions

# --- Langfuse tracing (optional; off unless both keys are set) ---
# Self-hosted is recommended in HIPAA mode (traces contain conversation text).
# Create a dedicated Langfuse org/project for this app and use ITS project keys here.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:53110
# LANGFUSE_TRACING_ENABLED=1   # set 0 to pause tracing without removing keys
# LANGFUSE_MASK_PHI=1          # redact names/phones/emails in traces while HIPAA_MODE=1
# LANGFUSE_TRACING_ENVIRONMENT=development
# RETAIN_LANGFUSE_DAYS=1       # retention.py deletes our (hospital-ai tagged) traces older than this

# --- Defaults (Admin UI can override via admin_settings.json) ---
# LLM_PROVIDER=deepseek
# BOT_MODE=cascade

# --- Admin login (no defaults; see HIPAA section below) ---
# ADMIN_USER=Admin
# ADMIN_TOKEN_SECRET=change-me-in-production

# --- Optional Daily transport ---
# DAILY_API_KEY=
# DAILY_ROOM_URL=

# --- Telegram booking bot ---
# TELEGRAM_BOT_TOKEN=

# --- Discord booking bot ---
# Create at https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=
# Optional: set to 1 only after enabling Message Content Intent in the portal
# DISCORD_MESSAGE_CONTENT_INTENT=0

# --- MCP server (python mcp_server.py) — for ChatGPT / Cursor remote tools ---
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000


# ============================ HIPAA / security ============================
# Fail-closed posture. Set to 0 ONLY for local dev with synthetic data.
# HIPAA_MODE=1
# Development with synthetic data only: keeps EVERY control on but lets non-BAA vendors/channels
# (DeepSeek, GLM, Telegram, Discord) be used. Must be removed before real patient data —
# `python go_live_check.py` refuses to pass while it is set.
# SYNTHETIC_DATA_ONLY=1
# Production-only exception: keep raw LLM prompt/response dumps for QA (admin-only, audited, 7-day retention)
# LLM_QA_DUMPS=0
# Single root for all PHI stores (db, chats, metrics, logs, audit, backups). Put it on an
# encrypted volume (LUKS / cloud-encrypted disk). Unset = legacy in-repo locations.
# DATA_DIR=/srv/dbc-care/data
# LLM vendors allowed to receive PHI (must have an executed BAA). DeepSeek/GLM are never allowed.
# PHI_ALLOWED_PROVIDERS=openai
# Channels that may not carry PHI (hand-off message only). Default in HIPAA mode: telegram,discord
# NON_PHI_CHANNELS=telegram,discord
# WEB_APP_URL=https://assistant.example-clinic.org/app
# Browser origins allowed to call the web API (CORS). Default: localhost:7860
# ALLOWED_ORIGINS=https://assistant.example-clinic.org
# Admin cookies only over HTTPS (default: on in HIPAA mode; set 0 for plain-HTTP local dev)
# COOKIE_SECURE=1
# Admin accounts: prefer `python manage_admin.py add <user>` (hashed, roles). Env fallback:
# ADMIN_USER=ops
# ADMIN_PASS_HASH=scrypt$...   # from: python manage_admin.py hash
# ADMIN_TOKEN_SECRET=<64 hex chars>   # or auto-created 0600 file .admin_token_secret
# Remote MCP (HTTP/SSE) bearer key — clients send "Authorization: Bearer <key>"
# MCP_API_KEY=<long random secret>
# MCP_ALLOWED_HOSTS=mcp.example-clinic.org
# Encrypted backups (python backup.py keygen) + retention (days)
# BACKUP_ENC_KEY=
# BACKUP_KEEP_LAST=14
# RETAIN_SESSIONS_DAYS=90
# RETAIN_TOOL_CALLS_DAYS=30
# RETAIN_TIMELINE_DAYS=30
# RETAIN_LLM_DUMPS_DAYS=7
# RETAIN_METRICS_DAYS=90
# RETAIN_BACKUPS_DAYS=35
