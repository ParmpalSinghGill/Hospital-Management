# ReceptionAi — AI receptionist for bookings
# Copy to `.env` and fill in keys. Never commit `.env`.
# Conda env: hosmanag

# --- Business identity ---
# Which front desk this is: hospital | restaurant | hotel
# Changes the words every agent uses (doctor/table/room, patient/guest, …).
# Also settable in Admin → Settings → Business.
# INDUSTRY=hospital
# Name the assistant introduces itself with.
# BUSINESS_NAME=ReceptionAi

# --- CLI text agent ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Cascade voice: Deepgram STT + DeepSeek LLM + Deepgram TTS ---
DEEPGRAM_API_KEY=
# Optional Owner/Admin key with billing:read (Admin balance display). Falls back to DEEPGRAM_API_KEY.
# DEEPGRAM_MANAGE_API_KEY=
# DEEPGRAM_VOICE=aura-2-thalia-en

# DeepSeek (Cascade LLM default)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

GLM_API_KEY=
# GLM_MODEL=glm-4-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Realtime voice: OpenAI ---
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- LLM transport (llm_transport.py) ---
# One shared keep-alive client; HTTP/2 multiplexes parallel calls on one connection.
# LLM_HTTP2=1
# Hedging: send N identical requests, use the first reply, cancel the rest.
# Cuts tail latency; multiplies token cost by up to N. 1 = off.
# LLM_HEDGE=1
# Stagger extra copies by this many ms (0 = send all at once).
# LLM_HEDGE_DELAY_MS=0

# --- Defaults (Admin UI can override via admin_settings.json) ---
# LLM_PROVIDER=deepseek
# BOT_MODE=cascade

# --- Admin login (defaults: Admin / 12345) ---
# ADMIN_USER=Admin
# ADMIN_PASS=12345
# ADMIN_TOKEN_SECRET=change-me-in-production

# --- Optional Daily transport ---
# DAILY_API_KEY=
# DAILY_ROOM_URL=

# --- Telegram booking bot ---
# TELEGRAM_BOT_TOKEN=

# --- Discord booking bot ---
# Create at https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=
# Optional: set to 1 only after enabling Message Content Intent in the portal
# DISCORD_MESSAGE_CONTENT_INTENT=0

# --- MCP server (python mcp_server.py) — for ChatGPT / Cursor remote tools ---
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

